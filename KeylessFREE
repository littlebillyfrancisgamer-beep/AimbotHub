-- ================= AIMBOT ENGINE =================
local function getClosestEnemy()
    local bestTarget = nil
    local shortestDist = _G_FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character and p.Character:FindFirstChild(_G_TargetPart) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = p.Character[_G_TargetPart]
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTarget = part
                    end
                end
            end
        end
    end
    return bestTarget
end

RunService.RenderStepped:Connect(function()
    if not _G_AimbotEnabled then return end
    
    local target = getClosestEnemy()
    if target then
        local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        if _G_Smoothness == 0 then
            Camera.CFrame = targetCFrame
        else
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / (_G_Smoothness * 0.4))
        end
    end
end)

-- ================= MULTI-TP ENEMIES ENGINE =================
local activeHeadTPTarget = nil
local deathConnection = nil

local function getNewRandomArsenalEnemy()
    local availableEnemies = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character and p.Character:FindFirstChild("Head") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(availableEnemies, p)
            end
        end
    end
    if #availableEnemies > 0 then
        return availableEnemies[math.random(1, #availableEnemies)]
    end
    return nil
end

local function watchArsenalTargetDeath(targetPlayer)
    if deathConnection then
        deathConnection:Disconnect()
        deathConnection = nil
    end
    if targetPlayer and targetPlayer.Character then
        local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            deathConnection = hum.Died:Connect(function()
                activeHeadTPTarget = getNewRandomArsenalEnemy()
                watchArsenalTargetDeath(activeHeadTPTarget)
            end)
        end
    end
end

RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = myChar.HumanoidRootPart
    
    if _G_MultiHeadTP then
        local targetValid = false
        if activeHeadTPTarget and activeHeadTPTarget.Character then
            local hum = activeHeadTPTarget.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and activeHeadTPTarget.Character:FindFirstChild("Head") then
                targetValid = true
            end
        end
        
        if not targetValid then
            activeHeadTPTarget = getNewRandomArsenalEnemy()
            watchArsenalTargetDeath(activeHeadTPTarget)
        end
        
        if activeHeadTPTarget and activeHeadTPTarget.Character and activeHeadTPTarget.Character:FindFirstChild("Head") then
            local targetHead = activeHeadTPTarget.Character.Head
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.CFrame = targetHead.CFrame * CFrame.new(0, 3, 0)
        end
    else
        activeHeadTPTarget = nil
        if deathConnection then
            deathConnection:Disconnect()
            deathConnection = nil
        end
    end
end)

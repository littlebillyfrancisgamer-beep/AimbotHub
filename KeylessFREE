-- Helper to create blue styled toggles
local function createToggle(parent, labelText, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(16, 25, 42)
    btn.BackgroundTransparency = 0.2
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Text = labelText .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(200, 220, 240)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 7) c.Parent = btn
    local s = Instance.new("UIStroke") s.Parent = btn s.Color = Color3.fromRGB(0, 120, 200) s.Thickness = 1
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = labelText .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            btn.TextColor3 = Color3.fromRGB(10, 14, 24)
        else
            btn.Text = labelText .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(16, 25, 42)
            btn.TextColor3 = Color3.fromRGB(200, 220, 240)
        end
        callback(state)
    end)
    return btn
end

-- Helper to create blue selectors
local function createSelector(parent, labelText, options, yPos, callback)
    local idx = 1
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(20, 32, 54)
    btn.BackgroundTransparency = 0.2
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Text = labelText .. ": " .. options[idx]
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 7) c.Parent = btn
    local s = Instance.new("UIStroke") s.Parent = btn s.Color = Color3.fromRGB(0, 140, 220) s.Thickness = 1
    
    btn.MouseButton1Click:Connect(function()
        idx = idx + 1
        if idx > #options then idx = 1 end
        btn.Text = labelText .. ": " .. options[idx]
        callback(options[idx])
    end)
    return btn
end

